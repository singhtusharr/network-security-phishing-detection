# Copy to .env and fill in. .env itself is git-ignored.
MONGO_DB_URL=mongodb://localhost:27017        # or a MongoDB Atlas "mongodb+srv://..." URL

# --- Optional: MLflow tracking + model registry ---
# Default (leave everything below blank/commented): local tracking in ./mlflow.db and ./mlruns.
# Hosted on DagsHub (needs your own DagsHub account + a repo there):
# DAGSHUB_REPO_OWNER=your-dagshub-username
# DAGSHUB_REPO_NAME=network-security-phishing-detection
# DAGSHUB_USER_TOKEN=your-dagshub-token         # lets dagshub.init authenticate without a browser prompt
# Or any other MLflow server:
# MLFLOW_TRACKING_URI=http://your-mlflow-server:5000
